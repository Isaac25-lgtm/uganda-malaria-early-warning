# ---------------------------------------------------------------------------
# Malaria Early Warning Dashboard - environment configuration
# Copy this file to `.env` and fill in real values. DO NOT commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (REQUIRED).
# The application is PostgreSQL-only and has NO SQLite fallback; it refuses to
# start if this is missing or is not a PostgreSQL URL.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/malaria_ews

# Flask session / CSRF signing key (REQUIRED outside local development).
# In local development only, a temporary random key is generated if this is
# unset, which means sessions do not survive a restart.
SECRET_KEY=change-this-to-a-long-random-string

# Flask CLI application discovery.
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0

# Set true only when the application is served to browsers over HTTPS.
# Keeping this false is necessary for the default localhost HTTP workflow.
SESSION_COOKIE_SECURE=false

# DHIS2 connection and metadata settings. DHIS2 usernames and passwords are
# entered at web sign-in or hidden CLI prompts and must not be added here.
DHIS2_BASE_URL=https://your-authorized-dhis2.example.org
DHIS2_TIMEOUT_SECONDS=30
DHIS2_VERIFY_SSL=true
DHIS2_CONFIRMED_MALARIA_DX=replace-with-approved-confirmed-malaria-uid
DHIS2_REPORTING_COMPLETENESS_DX=replace-with-approved-completeness-uid
DHIS2_DISTRICT_LEVEL=3

# Climate data acquisition. API credentials are optional; manual file mode is
# supported by placing files under data/climate/raw/ and registering them.
CLIMATE_DATA_DIR=data/climate
CHIRPS_BASE_URL=
ERA5_PROVIDER=
ERA5_API_KEY=
ERA5_API_URL=
ERA5_DOWNLOAD_MODE=manual_or_api
